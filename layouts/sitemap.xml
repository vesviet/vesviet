{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Site.Pages.ByLastmod.Reverse }}
    {{- if .Permalink }}
      {{- $isNoIndex := or .Params.noindex .Params.robotsNoIndex }}
      {{- $include := false }}
      {{- if not $isNoIndex }}
        {{- if in (slice "taxonomy" "term") .Kind }}
          {{- $isCategory := or (eq .Section "categories") (eq .Data.Singular "category") }}
          {{- if and $isCategory (ne .File nil) .Params.description }}
            {{- $include = true }}
          {{- end }}
        {{- else }}
          {{- $include = true }}
        {{- end }}
      {{- end }}
      {{- if $include }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
    {{- end }}
  </url>
      {{- end }}
    {{- end }}
  {{- end }}
</urlset>
